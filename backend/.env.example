# Google Gemini API Key (Khuyên dùng)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Tùy chọn)
OPENAI_API_KEY=your_openai_api_key_here

# Đợt 1: model LLM (đổi model thì cache cũ tự rớt nhờ namespace version).
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini

# FIX P0: môi trường chạy — development | production.
# production => CẤM mock fallback, thiếu key sẽ trả 503 thay vì data giả.
ENV=development

# FIX P0: cho phép mock fallback ở dev khi chưa có key (true/false).
# Production luôn ép False bất kể giá trị này.
ALLOW_MOCK_FALLBACK=true

# FIX P0: giới hạn số PDF dịch đồng thời để chống OOM (khuyên 1-3 tùy RAM).
MAX_CONCURRENT_TRANSLATIONS=2

# FIX P0: thời gian chờ slot dịch tối đa (giây) trước khi trả 429 cho client.
TRANSLATE_ACQUIRE_TIMEOUT_SEC=30

# CORS cho frontend (phân tách bằng dấu phẩy)
FRONTEND_ORIGINS=http://localhost:3000

# FIX P1: job queue bất đồng bộ (pipeline dài, progress qua WS).
# Số worker nền = MAX_CONCURRENT_TRANSLATIONS nếu không set riêng.
JOB_MAX_QUEUE=20
JOB_TTL_SEC=1800
JOB_MAX_JOBS=20

# Đợt 2: timeout tổng cho một job (giây) để PDF kẹt không giữ worker mãi.
JOB_TIMEOUT_SEC=1800

# Đợt 2: timeout cho vẽ lại sau edit (giây).
EDIT_TIMEOUT_SEC=120

# FIX P1: OCR hybrid cho PDF scan (true/false).
ENABLE_OCR=true
OCR_DPI=200
OCR_MIN_CONF=30
OCR_LANG=eng

# FIX P2: cache bản dịch cấp block (true/false).
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=2000
CACHE_TTL_SEC=86400

# Đợt 2: trần tài nguyên để PDF vector nhẹ mà hàng trăm trang
# không thổi chi phí token hay giữ worker quá lâu.
MAX_PDF_PAGES=300
MAX_BLOCKS_PER_CALL=60

# Đợt C: đặt token này thì POST /api/cache/clear phải kèm header
# X-Admin-Token đúng mới được xóa. Bỏ trống = ai cũng xóa được (chỉ nên ở dev).
# ADMIN_TOKEN=doi-pass-manh-o-day
